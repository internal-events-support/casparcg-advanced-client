{
  "name": "casparcg-canonical-client",
  "version": "1.1.0",
  "description": "CasparCG client with playlists, channel takes and local clip preview",
  "main": "dist/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "productName": "CasparCG Client",
  "author": "internal-events-support",
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node scripts/build.js && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.internal-events-support.casparcg-client",
    "productName": "CasparCG Client",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/test",
      "static/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "static/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CasparCG-Client-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CasparCG-Client-Portable-${version}.${ext}"
    }
  }
}
