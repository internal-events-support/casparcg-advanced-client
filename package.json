{
  "name": "casparcg-advanced-client",
  "version": "1.3.0",
  "description": "CasparCG client with playlists, channel takes and local clip preview",
  "main": "dist/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "productName": "CasparCG Advanced Client",
  "author": "neriftafu",
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node scripts/build.js && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.neriftafu.casparcg-advanced-client",
    "productName": "CasparCG Advanced Client",
    "copyright": "Copyright © 2026 neriftafu",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/test",
      "static/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "static/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "CasparCG-Advanced-Client-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "internal-events-support",
      "repo": "casparcg-advanced-client"
    }
  }
}
